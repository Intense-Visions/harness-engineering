# Force LF line endings for all text files to ensure consistent formatting
# across Windows, macOS, and Linux
* text=auto eol=lf

# Binary files that should not have line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Auto-generated baseline files — use "ours" merge strategy to avoid
# conflicts on every branch. Regenerate after merge instead.
#
# Requires one-time setup per clone:
#   git config merge.ours.driver true
.harness/**/baselines.json merge=ours
.harness/security/timeline.json merge=ours
**/.harness/**/baselines.json merge=ours
coverage-baselines.json merge=ours
benchmark-baselines.json merge=ours

# Generated roadmap aggregate — shards under docs/roadmap.d/ are the source of
# truth; docs/roadmap.md is regenerated by the pre-commit/post-merge hook.
# Same one-time per-clone setup as above: git config merge.ours.driver true
docs/roadmap.md merge=ours

# Comprehension shards (ADR 0108/0109) are a pure function of their module's
# source, so a conflict is resolved by REGENERATING from the merged source, never
# a hand-merge. Byte-stable shards (slice 1) already make same-change recompiles
# conflict-free; this driver auto-resolves the same-module residuals. One-time
# per-clone setup (run by `harness init`):
#   git config merge.comprehension.driver 'harness comprehension-merge-driver %O %A %B %P'
.harness/comprehension/**/_module.md merge=comprehension
