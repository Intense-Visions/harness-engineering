export PATH="$PATH:/opt/homebrew/bin"

# Fail-fast, self-contained: husky invokes this via `sh -e`, but make the
# guarantee explicit so a future husky bootstrap change can't silently drop it
# (husky v10 deprecates the current wrapper). POSIX-only — no bashisms below.
set -e

# Ensure the gates below run under the repo's pinned Node toolchain. The ambient
# `node` on a contributor's PATH may differ from the pin (.nvmrc / engines);
# native modules like better-sqlite3 are built against the pin and otherwise
# ABI-mismatch (NODE_MODULE_VERSION) deep inside the test gate (#910).
# ensure-node-pin.sh activates the pin via mise/nvm when available, or fails
# fast with an actionable message. Sourced so its PATH/`nvm use` change persists
# for the rest of this hook. POSIX-only (dash-safe), like the rest of this file.
# Guarded with an explicit `if` (not `[ -f ] && .`, which would return non-zero
# and abort the whole hook under `set -e`/`sh -e` when the helper is absent).
if [ -f .husky/ensure-node-pin.sh ]; then
  . .husky/ensure-node-pin.sh
fi

# Git exports GIT_DIR (and friends) to hooks — absolute in linked-worktree
# layouts. Child processes inherit it, so test suites that spawn `git` inside
# temp fixture dirs silently operate on THIS repo instead of the fixture
# (timeouts, wrong results, "Unable to read current working directory").
# Primary-clone pushes get a relative GIT_DIR=.git and dodge this by accident;
# worktree-based pushes hit it every time. Unset so every child re-discovers
# its own repo from its own cwd. Safe here: pre-push never touches the index,
# and repo-scoped commands below run from the repo root anyway.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR

# Mirror CI's changeset-check job so missing changesets fail locally
# (cheap diff-only script — runs in ~1s before the heavier steps).
pnpm run check:changesets

# Resolve an affected-base against origin/main. If it is unresolvable
# (fresh clone, detached HEAD, no remote), fall back to the FULL unscoped
# gate — erring toward MORE coverage, never a silently narrower one.
BASE="origin/main"
if git rev-parse --verify --quiet "$BASE" >/dev/null; then
  AFFECTED_OK=1
else
  AFFECTED_OK=0
  echo "pre-push: origin/main unresolvable — running full unscoped gate."
fi

if [ "$AFFECTED_OK" = "1" ]; then
  # Format check over only changed files (union of branch diff vs origin/main
  # and working-tree changes), filtered to prettier-relevant extensions. Catches
  # merge-missed files without scanning the whole repo.
  #   - --diff-filter=ACMR excludes Deletions: a deleted .ts/.md path must never
  #     reach `prettier --check` (it errors "No files matching the pattern" and,
  #     under `sh -e`, aborts the whole hook — blocking any rename/delete push).
  #   - `git diff HEAD` already covers staged + unstaged, so no separate --cached.
  #   - The `[ -f ]` pass drops any surviving non-existent path (rename source,
  #     staged-delete-then-reused) as belt-and-suspenders.
  # xargs is newline-split (space-fragile) but the repo has zero spaced paths;
  # POSIX `read`/BSD `xargs` lack NUL support, so newline is the portable choice.
  CHANGED=$(
    { git diff --name-only --diff-filter=ACMR "$BASE"...HEAD; \
      git diff --name-only --diff-filter=ACMR HEAD; \
      git ls-files --others --exclude-standard; } \
      | grep -E '\.(ts|tsx|md|json)$' | sort -u
  )
  # Trailing `:` keeps each loop iteration's exit status 0. Without it, an
  # empty $CHANGED (a diff that touches no {ts,tsx,md,json} file — e.g. a pure
  # .husky/scripts change) makes the final `[ -n "$f" ]` short-circuit to
  # non-zero; the `while` then exits non-zero, the command substitution inherits
  # it, and `set -e` aborts the whole hook — silently blocking any such push.
  EXISTING=$(printf '%s\n' "$CHANGED" | while IFS= read -r f; do [ -n "$f" ] && [ -f "$f" ] && printf '%s\n' "$f"; :; done)
  if [ -n "$EXISTING" ]; then
    printf '%s\n' "$EXISTING" | xargs pnpm exec prettier --check
  else
    echo "pre-push: no changed {ts,tsx,md,json} files to format-check."
  fi

  # Affected-scoped typecheck and coverage (base = origin/main, dependents included).
  pnpm exec turbo run typecheck --affected
  # Prune STALE coverage-summary.json before the affected run. `--affected`
  # regenerates coverage only for changed packages; an unaffected package keeps a
  # stale summary from a previous run that the ratchet would grade as a phantom
  # regression (#939). Removing them first makes "measured this run <=> file
  # present" hold, so the --allow-missing skip below is correct by construction.
  node scripts/coverage-ratchet.mjs --clean
  # Cap turbo concurrency to 2 packages-at-a-time. Without this, filesystem/sqlite/HTTP-heavy
  # tests flake under compound parallel load (Phase 2 raises this cap after test isolation).
  # Clear stale per-package reports so the summarizer only reads this run.
  find packages -maxdepth 2 -name .vitest-report.json -delete 2>/dev/null || true
  # HARNESS_PREPUSH activates the json reporter in each package's vitest config.
  # On non-zero exit, print a concise failing-test summary, then preserve the
  # blocking exit code (turbo's interleaved stream may drop the FAIL line, #1094).
  if ! HARNESS_PREPUSH=1 pnpm exec turbo run test:coverage --affected --concurrency=2; then
    node scripts/summarize-test-failures.mjs || true
    exit 1
  fi
  # Partial mode: --affected skips unchanged packages, so tolerate their missing coverage.
  # CI's ratchet runs flagless (full/authoritative) and is unaffected.
  node scripts/coverage-ratchet.mjs --allow-missing
else
  # Full fallback: whole-tree prettier + all-package typecheck/test.
  pnpm run format:check
  pnpm run typecheck
  find packages -maxdepth 2 -name .vitest-report.json -delete 2>/dev/null || true
  if ! HARNESS_PREPUSH=1 pnpm exec turbo run test:coverage --concurrency=2; then
    node scripts/summarize-test-failures.mjs || true
    exit 1
  fi
  node scripts/coverage-ratchet.mjs
fi

pnpm run generate-docs --check
pnpm run generate:tool-catalog:check
