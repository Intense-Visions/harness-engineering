{
  "version": 1,
  "name": "harness-engineering",
  "toolchain": {
    "cliVersion": ">=11"
  },
  "constraintPacks": ["secrets-and-injection"],
  "layers": [
    {
      "name": "types",
      "pattern": "packages/types/src/**",
      "allowedDependencies": []
    },
    {
      "name": "graph",
      "pattern": "packages/graph/src/**",
      "allowedDependencies": ["types"]
    },
    {
      "name": "core",
      "pattern": "packages/core/src/**",
      "allowedDependencies": ["types", "graph"]
    },
    {
      "name": "eslint-plugin",
      "pattern": "packages/eslint-plugin/src/**",
      "allowedDependencies": ["types", "core"]
    },
    {
      "name": "linter-gen",
      "pattern": "packages/linter-gen/src/**",
      "allowedDependencies": ["types", "core"]
    },
    {
      "name": "intelligence",
      "pattern": "packages/intelligence/src/**",
      "allowedDependencies": ["types", "graph"]
    },
    {
      "name": "orchestrator",
      "pattern": "packages/orchestrator/src/**",
      "allowedDependencies": ["types", "core", "intelligence"]
    },
    {
      "name": "dashboard",
      "pattern": "packages/dashboard/src/**",
      "allowedDependencies": ["types", "core", "graph", "intelligence"]
    },
    {
      "name": "cli",
      "pattern": "packages/cli/src/**",
      "allowedDependencies": ["types", "core", "graph", "linter-gen", "orchestrator"]
    }
  ],
  "forbiddenImports": [
    {
      "from": "packages/types/src/**",
      "disallow": [
        "packages/core/src/**",
        "packages/graph/src/**",
        "packages/intelligence/src/**",
        "packages/eslint-plugin/src/**",
        "packages/linter-gen/src/**",
        "packages/orchestrator/src/**",
        "packages/cli/src/**"
      ],
      "message": "Types layer cannot import from higher layers"
    },
    {
      "from": "packages/graph/src/**",
      "disallow": [
        "packages/core/src/**",
        "packages/intelligence/src/**",
        "packages/eslint-plugin/src/**",
        "packages/linter-gen/src/**",
        "packages/orchestrator/src/**",
        "packages/cli/src/**"
      ],
      "message": "Graph layer cannot import from higher layers"
    },
    {
      "from": "packages/core/src/**",
      "disallow": [
        "packages/intelligence/src/**",
        "packages/eslint-plugin/src/**",
        "packages/linter-gen/src/**",
        "packages/orchestrator/src/**",
        "packages/cli/src/**"
      ],
      "message": "Core layer cannot import from higher layers"
    },
    {
      "from": "packages/intelligence/src/**",
      "disallow": [
        "packages/core/src/**",
        "packages/eslint-plugin/src/**",
        "packages/linter-gen/src/**",
        "packages/orchestrator/src/**",
        "packages/dashboard/src/**",
        "packages/cli/src/**"
      ],
      "message": "Intelligence layer cannot import from core, orchestrator, dashboard, or CLI"
    },
    {
      "from": "packages/eslint-plugin/src/**",
      "disallow": [
        "packages/intelligence/src/**",
        "packages/orchestrator/src/**",
        "packages/cli/src/**"
      ],
      "message": "ESLint plugin cannot import from intelligence, orchestrator, or CLI"
    },
    {
      "from": "packages/linter-gen/src/**",
      "disallow": [
        "packages/intelligence/src/**",
        "packages/orchestrator/src/**",
        "packages/cli/src/**"
      ],
      "message": "Linter gen cannot import from intelligence, orchestrator, or CLI"
    },
    {
      "from": "packages/orchestrator/src/**",
      "disallow": ["packages/cli/src/**"],
      "message": "Orchestrator cannot import from CLI"
    }
  ],
  "boundaries": {
    "requireSchema": ["packages/cli/src/mcp/**"]
  },
  "architecture": {
    "enabled": true,
    "baselinePath": ".harness/arch/baselines.json",
    "thresholds": {
      "circular-deps": {
        "max": 0
      },
      "layer-violations": {
        "max": 0
      },
      "complexity": {
        "max": 15
      },
      "coupling": {
        "maxFanIn": 10,
        "maxFanOut": 8
      },
      "forbidden-imports": {
        "max": 0
      },
      "module-size": {
        "maxFiles": 30,
        "maxLoc": 3500
      },
      "dependency-depth": {
        "max": 7
      }
    },
    "modules": {}
  },
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "agent": {
    "executor": "subprocess",
    "timeout": 300000,
    "backends": {
      "primary": {
        "type": "claude",
        "command": "claude",
        "capabilities": {
          "tier": "strong",
          "costPer1kTokens": 15,
          "privacyClass": "shared-cloud",
          "contextWindow": 200000
        }
      },
      "local": {
        "type": "ollama",
        "endpoint": "http://127.0.0.1:11434/v1",
        "model": ["qwen3:32b", "qwen2.5-coder:7b", "gemma3n:e4b"],
        "disableReasoning": true,
        "capabilities": {
          "tier": "fast",
          "costPer1kTokens": 0,
          "privacyClass": "on-device",
          "contextWindow": 32768
        }
      }
    },
    "routing": {
      "default": "primary",
      "quick-fix": "local",
      "diagnostic": "local",
      "intelligence": {
        "sel": "local",
        "pesl": "local"
      },
      "policy": {
        "complexityTierMatrix": {
          "trivial": "fast",
          "simple": "fast",
          "moderate": "standard",
          "complex": "strong"
        },
        "escalationThreshold": 2
      }
    }
  },
  "security": {
    "enabled": true,
    "strict": false,
    "rules": {
      "SEC-CRY-001": "warning"
    },
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/tests/fixtures/**",
      "**/rehearsal-fixtures/**",
      "**/coverage/**",
      "**/packages/*/coverage/**",
      "**/security/rules/**",
      "**/.vitepress/cache/**",
      "**/.claude/worktrees/**",
      "**/.gradle/**",
      "**/.gradle-home/**",
      "**/bin/**"
    ]
  },
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/tests/fixtures/**",
      "**/rehearsal-fixtures/**",
      "**/coverage/**",
      "**/.gradle/**",
      "**/.gradle-home/**",
      "**/bin/**",
      "**/.vitepress/cache/**",
      "**/__fixtures__/**"
    ],
    "entryPoints": [
      "packages/types/src/index.ts",
      "packages/core/src/index.ts",
      "packages/graph/src/index.ts",
      "packages/intelligence/src/index.ts",
      "packages/cli/src/index.ts",
      "packages/cli/src/bin/harness.ts",
      "packages/eslint-plugin/src/index.ts",
      "packages/linter-gen/src/index.ts",
      "packages/orchestrator/src/index.ts",
      "packages/dashboard/src/client/main.tsx",
      "packages/dashboard/vite.config.ts",
      "packages/burn/tsup.config.ts",
      "packages/cli/tsup.config.ts",
      "packages/burn/src/index.ts",
      "packages/burn/src/bin/burn-hud.ts",
      "packages/local-models/src/index.ts",
      "packages/signals/src/index.ts",
      "packages/dashboard/src/server/serve.ts",
      "packages/cli/src/setup/print-clients.ts",
      "packages/cli/src/hooks/adoption-tracker.js",
      "packages/cli/src/hooks/block-no-verify.js",
      "packages/cli/src/hooks/cost-tracker.js",
      "packages/cli/src/hooks/format-check.js",
      "packages/cli/src/hooks/pre-compact-state.js",
      "packages/cli/src/hooks/protect-config.js",
      "packages/cli/src/hooks/quality-warner.js",
      "packages/cli/src/hooks/read-hook-stdin.js",
      "packages/cli/src/hooks/sentinel-post.js",
      "packages/cli/src/hooks/sentinel-pre.js",
      "packages/cli/src/hooks/session-retrospect.js",
      "packages/cli/src/hooks/session-retrospect-codex.js",
      "packages/cli/src/hooks/session-retrospect-cursor.js",
      "packages/cli/src/hooks/session-retrospect-gemini.js",
      "packages/cli/src/hooks/strict-quality-gate.js",
      "packages/cli/src/hooks/telemetry-reporter.js",
      "packages/cli/scripts/copy-assets.mjs",
      "packages/core/scripts/backfill-learnings-frontmatter.ts",
      "packages/eslint-plugin/scripts/generate-rules-barrel.mjs",
      "packages/linter-gen/scripts/copy-templates.mjs",
      "scripts/assert-baseline-only-diff.mjs",
      "scripts/assert-diff-scope.mjs",
      "scripts/audit-exceptions.mjs",
      "scripts/benchmark-check.mjs",
      "scripts/check-changesets.mjs",
      "scripts/clean.mjs",
      "scripts/coverage-ratchet.mjs",
      "scripts/design-capture.mjs",
      "scripts/generate-agent-setup-prompt.mjs",
      "scripts/generate-barrel-exports.mjs",
      "scripts/generate-core-barrel.mjs",
      "scripts/generate-docs.mjs",
      "scripts/generate-persona-workflows.mjs",
      "scripts/generate-plugin.mjs",
      "scripts/generate-tool-catalog.mjs",
      "scripts/main-health-check.mjs",
      "scripts/refresh-model-candidates.mjs",
      "scripts/summarize-test-failures.mjs",
      "scripts/sync-lockfile.mjs",
      "scripts/sync-plugin-pin.mjs",
      "scripts/vitest-prepush-reporter.mjs"
    ],
    "drift": {
      "docPaths": [
        "docs/index.md",
        "docs/api/**/*.md",
        "docs/conventions/**/*.md",
        "docs/guidelines/**/*.md",
        "docs/guides/**/*.md",
        "docs/knowledge/**/*.md",
        "docs/plans/**/*.md",
        "docs/security/**/*.md",
        "docs/standard/**/*.md"
      ],
      "forwardLookingPaths": [
        "docs/architecture/",
        "docs/decisions/",
        "docs/proposals/",
        "docs/adr/",
        "docs/changes/",
        "docs/knowledge/decisions/"
      ]
    },
    "autoFix": false
  },
  "performance": {
    "entryPoints": [
      "packages/types/src/index.ts",
      "packages/core/src/index.ts",
      "packages/graph/src/index.ts",
      "packages/intelligence/src/index.ts",
      "packages/cli/src/index.ts",
      "packages/cli/src/bin/harness.ts",
      "packages/eslint-plugin/src/index.ts",
      "packages/linter-gen/src/index.ts",
      "packages/orchestrator/src/index.ts"
    ],
    "complexity": {
      "enabled": true,
      "thresholds": {
        "cyclomaticComplexity": {
          "error": 15,
          "warn": 10
        },
        "nestingDepth": {
          "warn": 4
        },
        "functionLength": {
          "warn": 50
        },
        "parameterCount": {
          "warn": 5
        },
        "fileLength": {
          "info": 300
        },
        "hotspotPercentile": {
          "error": 95
        }
      }
    },
    "coupling": {
      "enabled": true,
      "thresholds": {
        "fanOut": {
          "warn": 15
        },
        "fanIn": {
          "info": 20
        },
        "couplingRatio": {
          "warn": 0.7
        },
        "transitiveDependencyDepth": {
          "info": 30
        }
      }
    },
    "sizeBudget": {
      "enabled": false,
      "budgets": {}
    }
  },
  "vocabulary": {
    "enabled": true,
    "rules": [
      {
        "deprecated": "sub-agent",
        "canonical": "subagent",
        "reason": "harness/Anthropic canonical spelling is the closed compound \"subagent\""
      },
      {
        "deprecated": "sub-task",
        "canonical": "subtask",
        "reason": "canonical spelling is the closed compound \"subtask\""
      },
      {
        "deprecated": "code base",
        "canonical": "codebase",
        "reason": "canonical spelling is the closed compound \"codebase\""
      },
      {
        "deprecated": "green field",
        "canonical": "greenfield",
        "reason": "canonical spelling is the closed compound \"greenfield\""
      },
      {
        "deprecated": "master branch",
        "canonical": "main branch",
        "reason": "the default branch is \"main\"; \"master\" is the retired name"
      }
    ]
  },
  "roadmap": {
    "tracker": {
      "kind": "github",
      "repo": "Intense-Visions/harness-engineering",
      "labels": ["roadmap"],
      "statusMap": {
        "backlog": "open",
        "planned": "open",
        "in-progress": "open",
        "done": "closed",
        "blocked": "open"
      },
      "reverseStatusMap": {
        "open": "planned",
        "closed": "done"
      }
    }
  },
  "template": {
    "level": "advanced",
    "version": 1
  },
  "graph": {
    "connectors": {
      "ci": {
        "apiKeyEnv": "GITHUB_TOKEN",
        "repo": "Intense-Visions/harness-engineering",
        "maxRuns": 20
      }
    }
  },
  "comprehension": {
    "semantic": true,
    "model": "claude-haiku-4-5-20251001",
    "concurrency": 4,
    "hook": true
  },
  "telemetry": {
    "enabled": true
  },
  "adoption": {
    "enabled": true
  },
  "pulse": {
    "enabled": true,
    "lookbackDefault": "30d",
    "primaryEvent": "skill_invoked",
    "valueEvent": "plan_completed",
    "completionEvents": [
      "validate_passed",
      "phase_completed",
      "task_completed",
      "review_completed"
    ],
    "qualityScoring": true,
    "qualityDimension": "output_correctness",
    "sources": {
      "analytics": "posthog",
      "tracing": null,
      "payments": null,
      "db": {
        "enabled": false
      }
    },
    "metricSourceOverrides": {},
    "pendingMetrics": [
      "Agent Autonomy",
      "Harness Coverage",
      "Context Density",
      "Drift Floor",
      "External Adoption"
    ],
    "excludedMetrics": []
  },
  "integrations": {
    "enabled": ["github", "exa"],
    "dismissed": []
  }
}
