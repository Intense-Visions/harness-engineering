{
  "name": "harness-engineering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Comprehensive toolkit for agent-first development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intense-Visions/harness-engineering.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:ci": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && node scripts/clean.mjs node_modules",
    "bench": "turbo run bench",
    "bench:graph-tokens": "node packages/cli/dist/bin/harness.js graph bench",
    "test:platform-parity": "vitest run tests/platform-parity.test.ts",
    "test:root": "vitest run",
    "test:e2e": "pnpm --filter @harness-engineering/cli exec vitest run tests/e2e",
    "test:e2e:live": "HARNESS_E2E_LIVE=1 pnpm run test:e2e",
    "orchestrator": "node packages/cli/dist/bin/harness.js orchestrator run",
    "orchestrator:dev": "turbo run build --filter=@harness-engineering/cli... && export HARNESS_PROJECT_PATH=\"$PWD\" && concurrently --names orch,dash --prefix-colors blue,green \"node packages/cli/dist/bin/harness.js orchestrator run --headless\" \"pnpm --filter @harness-engineering/dashboard dev\"",
    "dashboard:dev": "export HARNESS_PROJECT_PATH=\"$PWD\" && pnpm --filter @harness-engineering/dashboard dev",
    "dashboard:build": "pnpm --filter @harness-engineering/dashboard build",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "generate-docs": "node scripts/generate-docs.mjs",
    "generate:tool-catalog": "node scripts/generate-tool-catalog.mjs",
    "generate:tool-catalog:check": "node scripts/generate-tool-catalog.mjs --check",
    "generate:agent-setup-prompt": "node scripts/generate-agent-setup-prompt.mjs",
    "design:capture": "node scripts/design-capture.mjs",
    "generate-barrel-exports": "node scripts/generate-barrel-exports.mjs",
    "generate:barrels": "node scripts/generate-barrel-exports.mjs && node scripts/generate-core-barrel.mjs",
    "generate:barrels:check": "node scripts/generate-barrel-exports.mjs --check && node scripts/generate-core-barrel.mjs --check",
    "generate:plugin": "node scripts/generate-plugin.mjs",
    "generate:plugin:claude": "node scripts/generate-plugin.mjs --target claude",
    "generate:plugin:cursor": "node scripts/generate-plugin.mjs --target cursor",
    "generate:plugin:gemini": "node scripts/generate-plugin.mjs --target gemini",
    "generate:plugin:codex": "node scripts/generate-plugin.mjs --target codex",
    "generate:plugin:antigravity": "node scripts/generate-plugin.mjs --target antigravity",
    "generate:plugin:all": "pnpm generate:plugin:claude && pnpm generate:plugin:cursor && pnpm generate:plugin:gemini && pnpm generate:plugin:codex && pnpm generate:plugin:antigravity",
    "generate:plugin:check": "node scripts/generate-plugin.mjs --target claude --check && node scripts/generate-plugin.mjs --target cursor --check && node scripts/generate-plugin.mjs --target gemini --check && node scripts/generate-plugin.mjs --target codex --check && node scripts/generate-plugin.mjs --target antigravity --check",
    "generate:persona-workflows": "node scripts/generate-persona-workflows.mjs",
    "generate:persona-workflows:check": "node scripts/generate-persona-workflows.mjs --check",
    "changeset": "changeset",
    "check:changesets": "BASE_REF=origin/main node scripts/check-changesets.mjs",
    "check:audit-exceptions": "node scripts/audit-exceptions.mjs",
    "version": "changeset version && node scripts/sync-plugin-pin.mjs",
    "release": "pnpm build && node scripts/release-publish.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@harness-engineering/eslint-plugin": "workspace:^",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{ts,tsx,md,json}": "prettier --write",
    "package.json": "scripts/sync-lockfile.sh"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "neverBuiltDependencies": [
      "cpu-features"
    ],
    "overrides": {
      "hono": ">=4.13.11",
      "@grpc/grpc-js": "^1.14.5",
      "@hono/node-server": ">=2.1.3",
      "postcss": ">=8.5.23",
      "basic-ftp": ">=5.3.1",
      "body-parser": ">=2.3.0",
      "browserslist": ">=4.28.7",
      "fast-xml-parser": ">=5.7.0",
      "ip-address": ">=10.7.1",
      "fast-uri": ">=3.1.8 <4",
      "@humanfs/node": ">=0.16.8",
      "protobufjs": "^7.6.3",
      "undici": "^7.29.1",
      "qs": ">=6.16.0",
      "fflate": ">=0.8.3",
      "shell-quote": "^1.11.0",
      "tmp": "^0.2.6",
      "nanoid": ">=3.3.17 <4",
      "react-router": ">=7.18.2 <8",
      "@babel/core": "^7.29.6",
      "brace-expansion@2": ">=2.1.7 <3",
      "brace-expansion@5": ">=5.0.12 <6",
      "js-yaml@3": ">=3.15.2 <4",
      "js-yaml@4": ">=4.3.2 <5",
      "vite": ">=6.4.4 <7",
      "esbuild@0.27": ">=0.28.1",
      "uuid": "^11.1.1",
      "proxy-addr": ">=2.0.8",
      "source-map-js": ">=1.2.2",
      "postcss-selector-parser": ">=7.1.6",
      "@vue/server-renderer": ">=3.5.42",
      "vue": ">=3.5.42"
    }
  },
  "auditExceptions": {
    "GHSA-vfj7-8cjw-p6xm": {
      "reason": "braces stack-exhaustion DoS (high). NO UPSTREAM PATCH EXISTS - GitHub reports patched_versions '<0.0.0' and 3.0.3 is the latest release, so this cannot be cleared by a version move. Reached only as a transitive of micromatch, via @changesets/config, @changesets/git and fast-glob: build and release tooling that expands repo-authored glob patterns, never untrusted input, so the deeply-nested-pattern DoS has no attacker-controlled source in this repo. Re-evaluate when micromatch ships a braces-free major or upstream patches the 3.x line.",
      "expires": "2027-04-16"
    },
    "GHSA-hp3w-g68c-fv3c": {
      "reason": "sprintf-js unbounded-precision DoS (moderate). NO UPSTREAM PATCH EXISTS - patched_versions is '<0.0.0' and the advisory covers <=1.1.3, which is the latest release. Reached only via argparse@1.0.10 beneath js-yaml@3, i.e. dev and build tooling parsing repo-authored YAML; the format strings are library-internal and not attacker-supplied. The real remedy is eliminating the js-yaml@3 branch entirely (argparse 2.x drops the sprintf-js dependency), which is a structural dependency change rather than a bump and is tracked separately.",
      "expires": "2027-04-16"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  }
}
