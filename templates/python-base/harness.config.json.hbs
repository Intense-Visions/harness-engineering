{
  "version": 1,
  "name": "{{projectName}}",
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "deps": {
    "enabled": false
  },
  "entropy": {
    "enabled": false,
    "entryPoints": ["src/__init__.py"]
  },
  "performance": {
    "enabled": false
  },
  "template": {
    "language": "python",
    "version": 1,
    "tooling": {
      "packageManager": "pip",
      "linter": "ruff",
      "formatter": "ruff",
      "testRunner": "pytest"
    }
  }
}
